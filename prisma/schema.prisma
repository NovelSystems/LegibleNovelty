// Legible Novelty — Prisma schema (Stage 1: User Management).
//
// Stage 1 replaces Stage 0's placeholder `User`/`Session` proof-of-concept with
// the platform's real identity substrate: the `Account` model and everything
// User Management owns (subsystem 4 in the master design's Section 22 map).
//
// Field names are snake_case to match the Stage 1 brief's schema tables
// verbatim (so the DB columns — including the indexed `email_hash` and
// `display_name_hash` — are named exactly as specified). Prisma model names
// stay PascalCase.
//
// Design note on identity: the brief's Account table lists `email_hash` and
// `password_hash` but no plaintext `email` column, while Task 3's purge split
// ("plaintext email ... deleted on purge") and Task 10's transactional email
// triggers both require an actual address for active accounts. We therefore
// carry a nullable plaintext `email` (nulled at purge) ALONGSIDE the permanent
// `email_hash`. This omission-vs-requirement is flagged in the delivery summary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Shadow database used by `prisma migrate dev`.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  Community_Member
  Verified_Educator
  Moderator
  System_Admin
}

enum AccountStatus {
  active
  deactivated
  purged
}

enum ConnectionStatus {
  requested
  accepted
}

enum ConnectionCreatedVia {
  request
  invite_link_autoaccept
}

enum ApprovalType {
  one_time_pass
  standing_connection
}

enum ApprovalStatus {
  pending
  approved
  denied
}

enum VerificationPath {
  k12_professor
  license_holder
}

enum VerificationStatus {
  pending
  approved
  rejected
}

// Captured on every VE rejection regardless of Phase 1/2 — the training signal
// Phase 2's AI screening will eventually need (brief Task 6 / Section 4.1).
enum RejectionReasonCode {
  not_in_directory
  document_illegible
  document_inconsistent
  registry_mismatch
  other
}

enum FlagType {
  bad_peer_token_grant
  ve_conduct_review
}

enum FlagStatus {
  pending
  confirmed
  dismissed
}

enum AwardTargetType {
  account
  seed
  module
}

// Purpose of a short-lived, single-use token (email verification on signup,
// ordinary password reset, and the purged-account reclaim proof-of-control).
enum AccountTokenType {
  email_verification
  password_reset
  reclaim
}

// ---------------------------------------------------------------------------
// Account — the platform's real identity model (brief Task 1)
// ---------------------------------------------------------------------------

model Account {
  account_id String @id @default(uuid()) // Retained in the clear even post-purge.

  role Role @default(Community_Member)
  // Moderator / System_Admin assignment is manual/DB-only in Stage 1 — no admin
  // UI exists yet (stated limitation, not an oversight).

  // Required at creation for every account (enforced in application logic, since
  // Task 1 mandates it). Nullable at the column level ONLY because Task 3.5's
  // purge split deletes date of birth — the two requirements are reconciled by
  // making the column nullable and enforcing presence on create. Flagged in the
  // delivery summary as a Task 1 vs. Task 3.5 tension resolved this way.
  date_of_birth       DateTime?
  is_child_subaccount Boolean   @default(false)
  parent_account_id   String? // Set only for child sub-accounts.
  parent              Account?  @relation("ParentChild", fields: [parent_account_id], references: [account_id])
  children            Account[] @relation("ParentChild")

  // Stored base grade + the date it was last set. Effective grade is computed
  // lazily at read time by counting mid-August rollovers since the anchor (see
  // lib/grade.ts and Open Items — scheduling mechanism deliberately NOT a job).
  grade             Int?
  grade_anchor_date DateTime?

  country String? // Child public identity: "A [grade] learner from [Country]".

  preferred_display_name     String?
  legal_name                 String
  display_name_use_preferred Boolean @default(false)
  // Blocks reuse of any purged handle platform-wide — checked on EVERY display
  // name assignment (signup, rename, reclaim), not only reclaim.
  display_name_hash          String? @map("display_name_hash")

  // Generated at purge time (not creation); opaque, not derivable from id/email.
  purged_pseudonymous_identifier String?

  // Plaintext email of an active account (nulled at purge). See header note.
  email          String?   @unique
  email_verified DateTime? // Auth-adapter compatible verification timestamp.
  // Permanent, irreversible; reclaim-flow lookup. Indexed from day one.
  email_hash     String?
  // Retained post-purge (reclaim-flow use only; not a usable credential alone).
  password_hash  String?

  account_status AccountStatus @default(active)
  deactivated_at DateTime?
  purged_at      DateTime?

  // Priority routing / homepage defaults for later subsystems; unused in Stage 1.
  language_preference String[] @default([])
  interest_domains    String[] @default([])

  // Notification opt-outs by category (Task 10). Security-critical categories
  // (email verification, password reset) are never consulted here. Granular
  // category UI is deferred, but the storage does not preclude it.
  notification_opt_outs String[] @default([])

  // VE state (brief Task 6/7).
  ve_status                Boolean   @default(false)
  ve_granted_by_account_id String? // Convenience pointer; TokenGrant is the SoR.
  ve_granted_by            Account?  @relation("VeGrantedBy", fields: [ve_granted_by_account_id], references: [account_id])
  ve_granted               Account[] @relation("VeGrantedBy")
  ve_token_available       Boolean   @default(false) // Every VE holds exactly 1 at a time.

  // Columns only populated by later stages (kept real now per brief Task 1).
  lnc_status                    Boolean @default(false) // Certification Center (later).
  fotl_status                   Boolean @default(false) // Payments & Billing (later).
  veframework_onboarding_passed Boolean @default(false) // Placeholder gate; mechanism out of scope.

  // Cached "has this architect ever had a seed endorsed" flag, read on the
  // publish-quota hot path (Seed Editor Task 5). Default false; NOTHING in the
  // Seed Editor sub-stage sets it to true — Library's Endorsement logic does,
  // once it exists. Added now because the quota logic already reads it.
  first_seed_endorsement_received Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations (back-references).
  sessions                     Session[]
  tokens                       AccountToken[]
  connections_a                Connection[]              @relation("ConnectionA")
  connections_b                Connection[]              @relation("ConnectionB")
  parent_approvals_as_child    ParentApproval[]          @relation("ApprovalChild")
  parent_approvals_as_adult    ParentApproval[]          @relation("ApprovalAdult")
  verification_applications    VerificationApplication[] @relation("ApplicationApplicant")
  reviewed_applications        VerificationApplication[] @relation("ApplicationReviewer")
  tokens_granted               TokenGrant[]              @relation("GrantGranter")
  tokens_received              TokenGrant[]              @relation("GrantRecipient")
  flags                        AccountFlag[]             @relation("FlagAccount")
  flags_reviewed               AccountFlag[]             @relation("FlagReviewer")
  flags_secondary_reviewed     AccountFlag[]             @relation("FlagSecondaryReviewer")
  token_request_threads        TokenRequestThread[]
  award_nominations            AwardNomination[]
  awards_won                   AwardInstance[]
  // Workshop / Seed Editor.
  learning_seeds               LearningSeed[]
  seed_draft_invites           SeedDraftInvite[]
  seed_draft_comments          SeedDraftComment[]
  seed_revisions               SeedRevision[]            @relation("RevisionEditor")
  proposed_topics              Taxonomy[]                @relation("TaxonomyProposer")
  // Standing Scores (cross-cutting governance).
  standing_scores              StandingScore[]
  standing_score_events        StandingScoreEvent[]      @relation("EventAccount")
  moderated_score_events       StandingScoreEvent[]      @relation("EventModerator")
  seed_reports_filed           SeedReport[]              @relation("ReportReporter")
  seed_reports_resolved        SeedReport[]              @relation("ReportResolver")
  // Module Editor.
  modules_authored             ContextualizedModule[]
  module_reports_filed         ModuleReport[]            @relation("ModuleReportReporter")
  module_reports_resolved      ModuleReport[]            @relation("ModuleReportResolver")
  module_review_decisions      ModuleReviewDecision[]    @relation("ModuleDecisionModerator")
  // Lesson Planner.
  lesson_plans_created         LessonPlan[]              @relation("LessonPlanCreator")
  lesson_plan_assignments      LessonPlanAssignment[]    @relation("LessonPlanAssigner")
  lesson_plan_reports_filed    LessonPlanReport[]        @relation("LessonPlanReportReporter")
  lesson_plan_reports_resolved LessonPlanReport[]        @relation("LessonPlanReportResolver")
  // Library — Endorsement & Community Recommendation.
  endorsements_made            Endorsement[]             @relation("EndorserAccount")
  recommendations_made         CommunityRecommendation[] @relation("RecommenderAccount")

  // email_hash and display_name_hash are the two indexed lookup columns the
  // brief requires (reclaim / reuse-blocking hit them on every signup).
  @@index([email_hash])
  @@index([display_name_hash])
}

// ---------------------------------------------------------------------------
// Session — database-backed sessions (Auth.js, Account-scoped). Replaces the
// Stage 0 User-scoped Session. Login creates a row; logout deletes it.
// ---------------------------------------------------------------------------

model Session {
  id            String   @id @default(uuid())
  session_token String   @unique
  account_id    String
  account       Account  @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  expires       DateTime
}

// Single-use tokens for email verification, password reset, and reclaim proof.
model AccountToken {
  id           String           @id @default(uuid())
  token        String           @unique
  type         AccountTokenType
  account_id   String
  account      Account          @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  // For reclaim: the address the person is proving control of (may differ from
  // the purged account's original address, which is no longer stored plaintext).
  target_email String?
  expires      DateTime
  consumed_at  DateTime?
  created_at   DateTime         @default(now())

  @@index([account_id])
}

// Permanent blocklist of retired (purged) display-name hashes.
//
// A single `Account.display_name_hash` column cannot on its own keep a purged
// handle blocked forever: once that same row is reclaimed and given a NEW
// display name (brief Task 3 reclaim), its `display_name_hash` is overwritten,
// which would silently un-block the old handle. This table accumulates purged
// handles permanently so the platform-wide reuse check survives reclaim. The
// reuse check (lib/accounts.ts) unions active accounts' current
// `display_name_hash` with these retired hashes. Flagged in the delivery
// summary as an addition beyond Task 1's field list, required to actually make
// "permanently blocked from reuse" hold.
model RetiredDisplayName {
  hash       String   @id
  retired_at DateTime @default(now())
}

// Auth.js email-provider verification tokens (kept for adapter compatibility
// with the Stage 0 Nodemailer provider configuration).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Connection & ParentApproval (brief Task 4)
// ---------------------------------------------------------------------------

model Connection {
  connection_id String               @id @default(uuid())
  account_a_id  String
  account_a     Account              @relation("ConnectionA", fields: [account_a_id], references: [account_id])
  account_b_id  String
  account_b     Account              @relation("ConnectionB", fields: [account_b_id], references: [account_id])
  status        ConnectionStatus     @default(requested)
  created_via   ConnectionCreatedVia @default(request)
  created_at    DateTime             @default(now())

  @@index([account_a_id])
  @@index([account_b_id])
}

model ParentApproval {
  approval_id                 String         @id @default(uuid())
  child_account_id            String
  child_account               Account        @relation("ApprovalChild", fields: [child_account_id], references: [account_id])
  requesting_adult_account_id String
  requesting_adult            Account        @relation("ApprovalAdult", fields: [requesting_adult_account_id], references: [account_id])
  approval_type               ApprovalType
  // Closed loop from Stage 1: this was an unenforced UUID because LessonPlan
  // didn't exist yet. Now that Lesson Planner ships LessonPlan, it carries a real
  // FK constraint (Lesson Planner schema deliverable). Still optional — set only
  // for one_time_pass — and nullable so existing rows without a plan are intact.
  lesson_plan_id              String?
  lesson_plan                 LessonPlan?    @relation(fields: [lesson_plan_id], references: [lesson_plan_id])
  status                      ApprovalStatus @default(pending)
  created_at                  DateTime       @default(now())

  @@index([child_account_id])
  @@index([requesting_adult_account_id])
  @@index([lesson_plan_id])
}

// ---------------------------------------------------------------------------
// Verified Educator verification (brief Task 6)
// ---------------------------------------------------------------------------

model VerificationApplication {
  application_id               String               @id @default(uuid())
  applicant_account_id         String
  applicant                    Account              @relation("ApplicationApplicant", fields: [applicant_account_id], references: [account_id])
  path                         VerificationPath
  status                       VerificationStatus   @default(pending)
  reviewer_account_id          String?
  reviewer                     Account?             @relation("ApplicationReviewer", fields: [reviewer_account_id], references: [account_id])
  // Rejection reason is a structured code plus optional free-text elaboration
  // (not a bare string) — captured on every rejection, every path.
  rejection_reason_code        RejectionReasonCode?
  rejection_reason_elaboration String?
  submitted_document_ref       String? // license_holder path only.
  directory_lookup_confirmed   Boolean? // Set by the human reviewer.
  created_at                   DateTime             @default(now())
  decided_at                   DateTime?

  @@index([applicant_account_id])
  @@index([status])
}

model TokenGrant {
  grant_id             String    @id @default(uuid())
  granting_account_id  String
  granting_account     Account   @relation("GrantGranter", fields: [granting_account_id], references: [account_id])
  // Nullable: for a grant to an email with NO existing account yet, the
  // recipient account isn't known until the invite link is used to create one.
  recipient_account_id String?
  recipient_account    Account?  @relation("GrantRecipient", fields: [recipient_account_id], references: [account_id])
  // Set only for the no-account-yet path — the invited email address.
  recipient_email      String?
  // Set when the recipient completes account creation via the invite link (VE
  // status is conferred at that moment). Null + no account + >28d = expired.
  claimed_at           DateTime?
  granted_at           DateTime  @default(now())
  refreshed_at         DateTime? // Set 1 month after use (token refresh rule).

  flags AccountFlag[] @relation("FlagTokenGrant")

  @@index([granting_account_id])
  @@index([recipient_account_id])
}

// PROVISIONAL STAND-IN (brief Task 6 / Open Items). This is a narrow,
// purpose-built table for the VE token-request subforum ONLY. It is a
// deliberate, temporary stopgap for the future shared Post/Comment model with a
// `thread_type` discriminator (Communication subsystem, deferred). It must be
// consolidated into that shared model once Communication ships — it is NOT a
// permanent parallel system. The rationale auto-posts publicly as a new thread
// at the moment of application; the applicant has no other subforum access
// until a token is granted.
model TokenRequestThread {
  thread_id            String   @id @default(uuid())
  applicant_account_id String
  applicant            Account  @relation(fields: [applicant_account_id], references: [account_id])
  rationale            String // Auto-posted publicly at creation.
  created_at           DateTime @default(now())

  @@index([applicant_account_id])
}

// ---------------------------------------------------------------------------
// Peer token accountability (brief Task 7)
// ---------------------------------------------------------------------------

model AccountFlag {
  flag_id                String      @id @default(uuid())
  // Meaning of the flagged account differs by flag_type:
  //  - bad_peer_token_grant: the GRANTING educator.
  //  - ve_conduct_review:    the educator whose own conduct is under review.
  account_id             String
  account                Account     @relation("FlagAccount", fields: [account_id], references: [account_id])
  flag_type              FlagType
  // Populated for bad_peer_token_grant only; the specific disputed grant.
  related_token_grant_id String?
  related_token_grant    TokenGrant? @relation("FlagTokenGrant", fields: [related_token_grant_id], references: [grant_id])
  status                 FlagStatus  @default(pending)
  reason                 String
  // Primary moderator who initiates the review.
  reviewed_by            String?
  reviewer               Account?    @relation("FlagReviewer", fields: [reviewed_by], references: [account_id])
  // Second moderator who independently weighs in. A ve_conduct_review ESS lock
  // fires only when BOTH reviewers are set (two distinct accounts) AND status is
  // confirmed; a disagreeing secondary sets status = dismissed instead.
  secondary_reviewed_by  String?
  secondary_reviewer     Account?    @relation("FlagSecondaryReviewer", fields: [secondary_reviewed_by], references: [account_id])
  created_at             DateTime    @default(now())
  resolved_at            DateTime?

  @@index([account_id])
  @@index([flag_type])
}

// ---------------------------------------------------------------------------
// Awards — backend schema ONLY (brief Task 9). No user-facing surface reads or
// writes these in Stage 1.
// ---------------------------------------------------------------------------

model AwardCategory {
  category_id            String          @id @default(uuid())
  name                   String
  attachment_target_type AwardTargetType
  // Deliberately deferred pending platform activity data — left nullable, no
  // placeholder value invented (Open Items).
  eligibility_threshold  Int?
  is_cyclical            Boolean         @default(false)

  instances AwardInstance[]
}

model AwardInstance {
  instance_id                String        @id @default(uuid())
  category_id                String
  category                   AwardCategory @relation(fields: [category_id], references: [category_id])
  cycle_label                String? // e.g. "2026", only for cyclical categories.
  target_id                  String // The seed/module/account that won.
  winning_creator_account_id String?
  winning_creator            Account?      @relation(fields: [winning_creator_account_id], references: [account_id])
  date_granted               DateTime      @default(now())

  @@index([category_id])
}

model AwardNomination {
  nomination_id        String   @id @default(uuid())
  nominator_account_id String
  nominator            Account  @relation(fields: [nominator_account_id], references: [account_id])
  target_id            String
  rationale            String // Required.
  adjudicated_by       String? // Moderator, or platform-competition process.
  created_at           DateTime @default(now())

  @@index([nominator_account_id])
}

// ===========================================================================
// Workshop — Seed Editor (first sub-stage). Learning Seeds, their two-level
// Taxonomy, Seed Chains, and the private draft-sharing/comment workflow.
// ===========================================================================

enum SeedStatus {
  draft
  pending_review
  published
}

enum TaxonomyLevel {
  subject
  topic
}

enum SeedCommentStatus {
  open
  resolved
  dismissed
}

// Two-level, grade-independent taxonomy (Subject → Topic only; a third level
// was deliberately rejected). "Versioned so adding a Topic never breaks existing
// seed placements": nodes have stable ids and are additive, and a Topic that
// falls out of use is DEPRECATED (deprecated_at set), never hard-deleted, so any
// seed still placed under it keeps a valid reference. `version` records the
// taxonomy revision a node was introduced in.
model Taxonomy {
  taxonomy_id String        @id @default(uuid())
  level       TaxonomyLevel
  name        String
  // Topic → its parent Subject (null for a Subject). Self-relation.
  parent_id   String?
  parent      Taxonomy?     @relation("TaxonomyParent", fields: [parent_id], references: [taxonomy_id])
  children    Taxonomy[]    @relation("TaxonomyParent")

  version       Int       @default(1)
  deprecated_at DateTime?

  // Admin-set flag marking a government-or-political-systems Topic. Module Editor
  // reuses THIS existing Taxonomy node (rather than a separate module-level tag)
  // to route escalation-tier review (Module Editor Task 5). Flagged in the
  // delivery summary as an inference — if a standalone tag was intended instead,
  // this is the piece to change.
  is_political_systems Boolean @default(false)

  // Subjects/Topics are admin-maintained; a VE may PROPOSE a Topic and a
  // System_Admin approves. The proposal→approval routing is undecided (Open
  // Items) — these columns support it without deciding the workflow.
  proposed_by_account_id String?
  proposed_by            Account? @relation("TaxonomyProposer", fields: [proposed_by_account_id], references: [account_id])
  approved               Boolean  @default(true)

  created_at DateTime @default(now())

  seeds_as_subject LearningSeed[] @relation("SeedSubject")
  seeds_as_topic   LearningSeed[] @relation("SeedTopic")
  chains           SeedChain[]

  @@index([level])
  @@index([parent_id])
}

// A Learning Seed (Section 5.1). Minimal, reusable pedagogical object carrying
// no domain flavor. NO authoring gate — any Community Member may create one.
model LearningSeed {
  seed_id              String  @id @default(uuid())
  architect_account_id String
  architect            Account @relation(fields: [architect_account_id], references: [account_id])

  learning_objective      String
  entry_prerequisite      String
  // GENUINELY UNRESOLVED shape (Open Items) — only ever illustrated for Math.
  // Deliberately a loose JSON column, NOT over-designed; expected to firm up
  // through actual use of the editor, not from more spec work.
  algorithmic_constraints Json?
  lesson_size_scope       String // Explicitly declared, not implicit.

  subject_id String
  subject    Taxonomy @relation("SeedSubject", fields: [subject_id], references: [taxonomy_id])
  topic_id   String
  topic      Taxonomy @relation("SeedTopic", fields: [topic_id], references: [taxonomy_id])

  grade_range                    String // Free-text, deliberately not sortable.
  target_learner_characteristics String? // Optional.

  // Content language, needed for the language-coverage query (Task 3). Not in
  // the brief's field table, but the required query needs a language dimension
  // on the seed — flagged in the delivery summary as an added field.
  language String @default("en")

  // Miscellaneous/enriching seeds associate with a Topic via metadata ("enriches
  // this content within Topic Y") rather than a chain relationship — they enrich
  // rather than advance, so they are excluded from chain-advancement queries.
  is_enrichment Boolean @default(false)

  // Commission Marketplace doesn't exist yet — SOFT reference (plain UUID, no
  // enforced FK), same pattern as Stage 1's lesson_plan_id.
  associated_commission_id String?

  notes  String // The sizeable, deliberately-unstructured catch-all.
  status SeedStatus @default(draft)

  published_at DateTime? // Set when status → published; drives the daily quota.
  // Soft delete (same convention as Stage 1's Account). Deleting a published
  // seed frees a quota slot without losing the row for referential integrity.
  deleted_at   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invites         SeedDraftInvite[]
  comments        SeedDraftComment[]
  revisions       SeedRevision[]
  reports         SeedReport[]
  modules         ContextualizedModule[] // Modules whose primary seed is this seed.
  chain_edges_out SeedChain[]            @relation("ChainFrom")
  chain_edges_in  SeedChain[]            @relation("ChainTo")
  endorsements    Endorsement[] // Library: per-seed VE endorsements.

  @@index([architect_account_id])
  @@index([topic_id])
  @@index([status])
  // Composite index for the two hot quota queries (concurrent + daily).
  @@index([architect_account_id, status, published_at])
}

// A directed Seed Chain edge (Section 6.4): Seed A → Seed B, within a Topic.
// Chains are defined at the seed level and DECOUPLED from taxonomy structure;
// multiple competing chains can coexist in one Topic, distinguished by chain_key.
model SeedChain {
  chain_edge_id String       @id @default(uuid())
  topic_id      String
  topic         Taxonomy     @relation(fields: [topic_id], references: [taxonomy_id])
  // Distinguishes competing chains within the same Topic.
  chain_key     String
  from_seed_id  String
  from_seed     LearningSeed @relation("ChainFrom", fields: [from_seed_id], references: [seed_id])
  to_seed_id    String
  to_seed       LearningSeed @relation("ChainTo", fields: [to_seed_id], references: [seed_id])
  created_at    DateTime     @default(now())

  @@unique([chain_key, from_seed_id, to_seed_id])
  @@index([topic_id])
  @@index([chain_key])
}

// Draft-sharing invite (Section 7.1). The architect invites SPECIFIC registered
// accounts (never open links). Auto-revoked on submission to Pending Review.
model SeedDraftInvite {
  invite_id          String       @id @default(uuid())
  seed_id            String
  seed               LearningSeed @relation(fields: [seed_id], references: [seed_id])
  invited_account_id String
  invited_account    Account      @relation(fields: [invited_account_id], references: [account_id])
  invited_at         DateTime     @default(now())
  revoked_at         DateTime? // Set automatically on submission to Pending Review.

  @@index([seed_id])
  @@index([invited_account_id])
}

// Threaded draft comment (Section 7.1). GENERIC by design: commenter_account_id
// is either an invited draft-reviewer (this sub-stage) OR, later, an endorsing
// VE (Library's endorsement-return-to-draft flow) — same table, same mechanism,
// no hardcoded actor type, so Library reuses it without a schema change.
model SeedDraftComment {
  comment_id           String             @id @default(uuid())
  seed_id              String
  seed                 LearningSeed       @relation(fields: [seed_id], references: [seed_id])
  commenter_account_id String
  commenter            Account            @relation(fields: [commenter_account_id], references: [account_id])
  // Optional threading: a reply points at its parent comment.
  parent_comment_id    String?
  parent_comment       SeedDraftComment?  @relation("CommentThread", fields: [parent_comment_id], references: [comment_id])
  replies              SeedDraftComment[] @relation("CommentThread")
  body                 String
  status               SeedCommentStatus  @default(open) // Set by the architect.
  created_at           DateTime           @default(now())
  resolved_at          DateTime?

  @@index([seed_id])
  @@index([commenter_account_id])
}

// Revision history for a published seed — a "controlled document," NOT a wiki.
//
// The parent LearningSeed.architect_account_id is the fixed, permanent document
// OWNER and is never reassigned by anyone's edit (including a moderator's).
// Each SeedRevision records who actually made THAT revision (editor_account_id)
// — the architect or a Moderator — so there is no single evolving "author":
// a fixed owner (the seed) plus a per-revision editor (the revision).
//
// Only the architect or a Moderator may create a revision (enforced in
// lib/seeds.ts), only on a published seed, and edits are exempt from the publish
// quota. Each revision stores a FULL SNAPSHOT of the seed's content (not a diff).
// History is view-only: there is deliberately NO restore-to-a-prior-revision.
model SeedRevision {
  revision_id       String       @id @default(uuid())
  seed_id           String
  seed              LearningSeed @relation(fields: [seed_id], references: [seed_id])
  editor_account_id String
  editor            Account      @relation("RevisionEditor", fields: [editor_account_id], references: [account_id])
  // Sequential per seed (1-based), for stable ordering of queryable history.
  revision_number   Int

  // Snapshot of the fact AT EDIT TIME: was this made by a Moderator exercising
  // the moderator permission (i.e. an editor who is not the seed's owner)?
  // Snapshotted rather than re-derived from a live Account.role join, which
  // could give the wrong answer if that account's role changes later — same
  // snapshot-not-re-derive reasoning as other historical records in this project.
  made_as_moderator Boolean
  // Mandatory when made_as_moderator is true (enforced in application logic);
  // optional for the architect's own edits — hence nullable at the column level.
  edit_summary      String?

  // Full content snapshot of the seed as of this revision (not a diff).
  // subject_id / topic_id are stored as plain snapshot values (no FK), since a
  // revision is a historical record of placement as it was at edit time.
  learning_objective             String
  entry_prerequisite             String
  algorithmic_constraints        Json?
  lesson_size_scope              String
  subject_id                     String
  topic_id                       String
  grade_range                    String
  target_learner_characteristics String?
  language                       String
  notes                          String
  is_enrichment                  Boolean

  created_at DateTime @default(now())

  // Modules pinned to this exact archived revision (Module Editor Task 1).
  modules_primary        ContextualizedModule[] @relation("ModulePrimaryRevision")
  module_secondary_seeds ModuleSecondarySeed[]

  @@unique([seed_id, revision_number])
  @@index([seed_id])
  @@index([editor_account_id])
}

// ===========================================================================
// Standing Scores (ESS / DSS / CSS) — cross-cutting content-governance
// infrastructure (source: Content Governance Policy Section 10). One shared
// mechanic (scale, weekly drift, 0-lock, restoration) across three score types,
// modeled with a score_type discriminator rather than three parallel tables.
// Both tables are internal moderation-triage data, invisible to the account
// holder (Section 10.1).
// ===========================================================================

enum StandingScoreType {
  ESS // Educator Standing Score
  DSS // Developer Standing Score
  CSS // Community Standing Score
}

model StandingScore {
  standing_score_id      String            @id @default(uuid())
  account_id             String
  account                Account           @relation(fields: [account_id], references: [account_id])
  score_type             StandingScoreType
  // MUST be decimal (not integer): DSS has a +0.1 trigger an integer column
  // would silently round away.
  current_value          Decimal           @db.Decimal(6, 2)
  locked_at              DateTime? // Set when the value hits 0 (or a direct trigger).
  // Drives the lazy weekly-drift calculation (Task 2); not a display field.
  last_drift_computed_at DateTime

  // One row per (account, score_type) pair.
  @@unique([account_id, score_type])
  @@index([account_id])
}

// The Historical Infraction Record (Section 10.6). APPEND-ONLY — rows are never
// updated or deleted.
model StandingScoreEvent {
  event_id             String            @id @default(uuid())
  account_id           String
  account              Account           @relation("EventAccount", fields: [account_id], references: [account_id])
  score_type           StandingScoreType
  point_delta          Decimal           @db.Decimal(6, 2) // Positive or negative.
  // Extensible label, e.g. ve_token_rescinded, seed_report_dss_egregious, ess_lock.
  event_type           String
  // moderator_account_id and explanation are required TOGETHER whenever an entry
  // results from a moderator decision; neither is required for a system-triggered
  // (e.g. numeric 0-floor lock) event. Enforced in lib/standing-scores.ts.
  moderator_account_id String?
  moderator            Account?          @relation("EventModerator", fields: [moderator_account_id], references: [account_id])
  explanation          String?
  created_at           DateTime          @default(now())

  @@index([account_id])
  @@index([score_type])
}

// ===========================================================================
// SeedReport — the free-text vandalism report path the Seed Editor lacked
// (Standing Scores Task 5). Deliberately lighter than Module's eventual report
// system: no auto-escalation ladder. Resolution routes through the already-built
// SeedRevision moderator-edit path — there is no separate takedown mechanism.
// ===========================================================================

enum SeedReportStatus {
  pending
  resolved
}

model SeedReport {
  report_id           String           @id @default(uuid())
  seed_id             String
  seed                LearningSeed     @relation(fields: [seed_id], references: [seed_id])
  reporter_account_id String
  reporter            Account          @relation("ReportReporter", fields: [reporter_account_id], references: [account_id])
  reason              String
  status              SeedReportStatus @default(pending)
  created_at          DateTime         @default(now())
  resolved_at         DateTime?
  resolved_by         String? // Moderator who resolved it.
  resolver            Account?         @relation("ReportResolver", fields: [resolved_by], references: [account_id])

  @@index([seed_id])
  @@index([reporter_account_id])
  @@index([status])
}

// ===========================================================================
// Workshop — Module Editor (second sub-stage). A Contextualized Module wraps a
// primary Learning Seed in domain-flavored teaching content across a sequence of
// positioned-element pages, with lifecycle/versioning, a deterministic
// publication gate, report-driven takedown wired into Standing Scores, and a
// content-governance review layer.
// ===========================================================================

enum ModuleStatus {
  draft
  pending_review
  moderation_hold
  published
}

enum AiAttestation {
  wholly_human
  ai_assisted_manual_flair
  ai_pipeline
}

enum ModuleElementType {
  text
  image
  fillable_field // Reserved; fillable fields normally nest inside text content.
}

enum ModuleDecisionType {
  retain
  reject
}

// Structured citation for a rejection (not free text) — the clause a Moderator
// applies (Content Governance Policy Sections 3/5/6).
enum CitedClause {
  charter
  functional_test
  comparison_rule
}

enum ModuleReviewAppealStatus {
  pending
  resolved
}

enum ModuleReportStatus {
  pending
  resolved
}

model ContextualizedModule {
  module_id         String  @id @default(uuid())
  author_account_id String
  author            Account @relation(fields: [author_account_id], references: [account_id])

  // Exactly one mandatory primary seed — what educator endorsement vouches for.
  primary_seed_id          String
  primary_seed             LearningSeed @relation(fields: [primary_seed_id], references: [seed_id])
  // Pinned at creation, permanent: the exact archived SeedRevision the module was
  // built against (a real FK, not a bare version string). Editing the seed later
  // creates a new revision but never retroactively changes this citation.
  primary_seed_revision_id String
  primary_seed_revision    SeedRevision @relation("ModulePrimaryRevision", fields: [primary_seed_revision_id], references: [revision_id])

  // Secondary seeds (max 3, app-enforced) are modeled as a join table so each
  // reference can PIN to a SeedRevision the same way the primary does (INFERRED
  // requirement — flagged in the summary). Locked at submission to Pending Review.
  secondary_seeds ModuleSecondarySeed[]

  // prerequisite_followon_refs and lesson_size_scope are DERIVED from the primary
  // seed's chain relationships / the pinned revision (see lib/modules.ts), not
  // stored columns.

  version          Int       @default(0) // Increments on publish, not on autosave.
  publication_date DateTime?

  // Author-declared at submission; locks permanently if ai_pipeline (Task 2).
  ai_attestation AiAttestation?

  // Commission Marketplace isn't built — soft reference (no FK). The snapshot
  // text freezes at first association/publication and never updates after.
  associated_commission_id String?
  commission_snapshot_text String?

  // INERT placeholder columns (Task 1) — nothing in this sub-stage reads or
  // writes them.
  prepublication_review_report String? // Section 8 DEF/Justice report (Phase 2).
  flair_tags                   String[] @default([]) // Groundwork only, no UI.

  // Library — Search/Ranking/Discovery (Sections 9.5–9.7). Added by that
  // sub-stage, NOT in Module Editor's original field list (flagged as a
  // retroactive addition, same category as Seed Editor's language/published_at).
  //
  // context_tag: the single special-interest ("Context") tag Section 9.7's Quick
  // Search listbox filters on — "each module carries exactly one Context tag", so
  // the multi-select OR is a single-column `IN (...)` check, not a join. Nullable:
  // a module need not have one set.
  context_tag              String?
  // Usage-sort inputs (Sections 9.3). Nothing increments these yet — downloads
  // depend on PDF Generation (Section 15, unbuilt) and passing completions on
  // Quiz/Scoring (Section 7.4, deferred). The columns exist so the Weighted/
  // Unweighted Usage formulas have real fields to read once those land, the same
  // forward-building pattern as everything else in this project.
  download_count           Int     @default(0)
  passing_completion_count Int     @default(0)

  status ModuleStatus @default(draft)

  // Version whose automatic-takedown trigger a moderator has cleared (disarmed).
  // Reports on a disarmed version route to the queue only. Publishing a new
  // version increments `version`, so it no longer matches → re-armed (Task 4).
  takedown_disarmed_version Int?
  // Set when 2 distinct reporters trigger automatic takedown pending review.
  auto_taken_down           Boolean @default(false)

  // True once the seed reference changed on an existing module; makes the next
  // publish run the seed-alignment check (Task 3), then clears.
  seed_ref_changed Boolean @default(false)

  // Edit timestamp for Library's "edited under you" warning (Task 2); the
  // warning trigger and line-count delta consumption are Library's.
  last_edited_at DateTime?

  // Element-count baseline snapshotted at each publish (count of this module's
  // ModuleElement rows when the current version went live). Module content is
  // page/element JSON with no notion of "lines", so Library's "edited under you"
  // warning quantifies change as an ELEMENT-count delta (current count minus this
  // baseline) — the structural analog of the design's line-count delta. Nullable
  // for modules never published (no live version to have baselined).
  published_element_count Int?

  // Library idempotency latch: the ESS +5 "first endorser" reward (paid when the
  // module reaches 10 Community Recommendations, Section 9-linked Standing Score
  // trigger) fires exactly once per module. Set true when paid so a toggle-driven
  // re-cross of the 10-recommendation threshold never double-pays.
  ess_first_endorser_rewarded Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pages               ModulePage[]
  reports             ModuleReport[]
  review_decisions    ModuleReviewDecision[]
  appeals             ModuleReviewAppeal[]
  // Live (unpinned) references from lesson-plan playlists (Lesson Planner).
  lesson_plan_entries LessonPlanModule[]        @relation("LessonPlanModuleRef")
  // Library: community recommendations (module-level, eligibility-gated).
  recommendations     CommunityRecommendation[]

  @@index([author_account_id])
  @@index([primary_seed_id])
  @@index([status])
  @@index([context_tag]) // Library Quick Search Context filter (IN check).
}

// Join table pinning each secondary seed citation to a specific SeedRevision.
model ModuleSecondarySeed {
  id               String               @id @default(uuid())
  module_id        String
  module           ContextualizedModule @relation(fields: [module_id], references: [module_id], onDelete: Cascade)
  seed_revision_id String
  seed_revision    SeedRevision         @relation(fields: [seed_revision_id], references: [revision_id])

  @@unique([module_id, seed_revision_id])
  @@index([module_id])
}

// --- Authoring model (Task 7) ------------------------------------------------

model ModuleTemplate {
  template_id    String  @id @default(uuid())
  name           String
  description    String?
  // Pre-arranged element positions/types/placeholder content, instantiated into
  // real ModuleElement rows when picked. Admin-authored only for now (flagged).
  element_layout Json

  pages ModulePage[]
}

model ModulePage {
  page_id     String               @id @default(uuid())
  module_id   String
  module      ContextualizedModule @relation(fields: [module_id], references: [module_id], onDelete: Cascade)
  page_order  Int
  // Informational: which template this page started from (if any). Does NOT
  // constrain later edits — a template is a prefill, not a locked mode.
  template_id String?
  template    ModuleTemplate?      @relation(fields: [template_id], references: [template_id])

  elements ModuleElement[]

  @@index([module_id])
}

model ModuleElement {
  element_id   String            @id @default(uuid())
  page_id      String
  page         ModulePage        @relation(fields: [page_id], references: [page_id], onDelete: Cascade)
  element_type ModuleElementType
  position_x   Float
  position_y   Float
  width        Float
  height       Float
  z_index      Int
  // Shape depends on element_type (type-discriminator + flexible content, same
  // pattern as AccountFlag.flag_type / AwardInstance.target_id). A `text`
  // element's content is TipTap rich content; fillable fields nest inside it as
  // custom nodes with a unique id (@tiptap/extension-unique-id).
  content      Json

  @@index([page_id])
}

// --- Content-governance review (Task 5) --------------------------------------

model ModuleReviewDecision {
  decision_id          String               @id @default(uuid())
  module_id            String
  module               ContextualizedModule @relation(fields: [module_id], references: [module_id])
  moderator_account_id String
  moderator            Account              @relation("ModuleDecisionModerator", fields: [moderator_account_id], references: [account_id])
  decision             ModuleDecisionType
  // Structured citation required on a rejection (nullable when retained).
  cited_clause         CitedClause?
  section_reference    String? // The specific module section identified.
  rationale            String
  created_at           DateTime             @default(now())

  appeals ModuleReviewAppeal[]

  @@index([module_id])
}

model ModuleReviewAppeal {
  appeal_id            String                   @id @default(uuid())
  module_id            String
  module               ContextualizedModule     @relation(fields: [module_id], references: [module_id])
  original_decision_id String
  original_decision    ModuleReviewDecision     @relation(fields: [original_decision_id], references: [decision_id])
  status               ModuleReviewAppealStatus @default(pending)
  // Panel of 3+ distinct reviewers (app-enforced), spanning varied backgrounds,
  // not limited to credentialed VEs. Stored as a plain UUID array (soft
  // references) — the per-element FK a relation would need isn't expressible on
  // an array; distinctness/count is enforced in lib/module-reports.ts.
  panel_reviewer_ids   String[]
  panel_rationale      String?
  resolved_at          DateTime?

  @@index([module_id])
}

// --- Report-driven takedown (Task 4) — mirrors SeedReport exactly ------------

model ModuleReport {
  report_id           String               @id @default(uuid())
  module_id           String
  module              ContextualizedModule @relation(fields: [module_id], references: [module_id])
  reporter_account_id String
  reporter            Account              @relation("ModuleReportReporter", fields: [reporter_account_id], references: [account_id])
  reason              String
  // The module version this report was filed against — the takedown trigger and
  // its disarm state are per-version (Task 4).
  module_version      Int
  // True if filed against a version a moderator already cleared ("previously
  // reviewed") — such reports route to the queue only, never auto-takedown.
  previously_reviewed Boolean              @default(false)
  status              ModuleReportStatus   @default(pending)
  created_at          DateTime             @default(now())
  resolved_at         DateTime?
  resolved_by         String?
  resolver            Account?             @relation("ModuleReportResolver", fields: [resolved_by], references: [account_id])

  @@index([module_id])
  @@index([reporter_account_id])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Workshop — Lesson Planner (Section 12.1). A "playlist" of published modules
// a community member curates and an (possibly different) assigner hands to
// learners. Deliberately un-gated: no VE-status check and no DSS authoring lock
// on creation or assignment (curation of already-vetted content is not
// authoring). See lib/lesson-plans.ts.
// ---------------------------------------------------------------------------

model LessonPlan {
  lesson_plan_id     String   @id @default(uuid())
  // Any community member — no role restriction, no VE requirement (Task 1).
  creator_account_id String
  creator            Account  @relation("LessonPlanCreator", fields: [creator_account_id], references: [account_id])
  title              String
  is_public          Boolean  @default(false)
  created_at         DateTime @default(now())

  // The ordered playlist. Each entry references the LIVE module_id (a real FK to
  // ContextualizedModule), NOT a pinned version or SeedRevision — the OPPOSITE of
  // how a Module pins its seed. Curation is the point: a lesson plan always
  // reflects a module's CURRENT published state, never a frozen snapshot of what
  // it was when added (Task 1, confirmed by test).
  module_sequence LessonPlanModule[]

  assignments      LessonPlanAssignment[]
  reports          LessonPlanReport[]
  // Back-relation for the FK closed on ParentApproval.lesson_plan_id below.
  parent_approvals ParentApproval[]

  @@index([creator_account_id])
  @@index([is_public])
}

// Ordered join row: position gives the playlist order (add / remove / reorder).
// The module reference is live — resolving it always joins to the module's
// current row, so an edit to the module surfaces immediately in every plan.
model LessonPlanModule {
  id             String               @id @default(uuid())
  lesson_plan_id String
  lesson_plan    LessonPlan           @relation(fields: [lesson_plan_id], references: [lesson_plan_id], onDelete: Cascade)
  module_id      String
  module         ContextualizedModule @relation("LessonPlanModuleRef", fields: [module_id], references: [module_id])
  position       Int

  @@index([lesson_plan_id])
  @@index([module_id])
}

// A single assignment instance: one lesson plan, one assigner (NOT necessarily
// the creator), a set of learners, and a date range. Each assignment is its own
// record so the same plan handed to different cohorts never conflates their data
// (Task 2). assigned_learner_ids mirrors the String[]-of-account-ids convention
// already used by ModuleReviewAppeal.panel_reviewer_ids (Prisma has no
// array-of-FK relation).
model LessonPlanAssignment {
  assignment_id        String     @id @default(uuid())
  lesson_plan_id       String
  lesson_plan          LessonPlan @relation(fields: [lesson_plan_id], references: [lesson_plan_id], onDelete: Cascade)
  assigner_account_id  String
  assigner             Account    @relation("LessonPlanAssigner", fields: [assigner_account_id], references: [account_id])
  assigned_learner_ids String[]
  date_range_start     DateTime
  date_range_end       DateTime
  created_at           DateTime   @default(now())

  @@index([lesson_plan_id])
  @@index([assigner_account_id])
}

// Free-text `title` vandalism gap — the same lightweight shape as SeedReport (no
// auto-escalation ladder). A moderator resolves by correcting the title or
// deactivating the plan (is_public → false); CSS consequences applied in
// lib/lesson-plan-reports.ts (Task 3).
model LessonPlanReport {
  report_id           String                 @id @default(uuid())
  lesson_plan_id      String
  lesson_plan         LessonPlan             @relation(fields: [lesson_plan_id], references: [lesson_plan_id])
  reporter_account_id String
  reporter            Account                @relation("LessonPlanReportReporter", fields: [reporter_account_id], references: [account_id])
  reason              String
  status              LessonPlanReportStatus @default(pending)
  created_at          DateTime               @default(now())
  resolved_at         DateTime?
  resolved_by         String?
  resolver            Account?               @relation("LessonPlanReportResolver", fields: [resolved_by], references: [account_id])

  @@index([lesson_plan_id])
  @@index([reporter_account_id])
  @@index([status])
}

enum LessonPlanReportStatus {
  pending
  resolved
}

// ===========================================================================
// Library — Endorsement & Community Recommendation (first Library sub-stage;
// master design Sections 9.1–9.2). These are the two core "trust actions" the
// rest of the platform's search/ranking/visibility/Standing-Score wiring has
// been forward-built to consume. Both are ADDITIVE-ONLY binary toggles — there
// is deliberately no reject/downvote counterpart (Section 9.1: the only
// rejection path for published content is moderation, Section 10.4).
// ===========================================================================

// Endorsement (Section 9.1) — PER-SEED, not per-module. A module's primary seed
// and each secondary seed carry independent endorsement state, so this row keys
// on `seed_id`, never `module_id`. Endorsement eligibility is VE-OR-LNC, checked
// LIVE at action time in lib/endorsement.ts (not a cached column here).
//
// TOGGLE = HARD DELETE: clicking again removes the endorsement. Unlike
// StandingScoreEvent's append-only infraction log, there is no stated need to
// retain a removed endorsement's history, so a removed endorsement leaves no
// row — a plain unique constraint over (seed, endorser) enforces "at most one
// live endorsement per endorser per seed" and makes the toggle a create/delete
// pair.
//
// VE-OR-LNC (resolved): Section 9.1's prose reads "only Verified Educators may
// endorse," but Section 22's summary of the same section says "for Endorsement,
// VE/LNC status specifically" — Section 22's broader reading is correct, and an
// LNC-certified account holds the same functional endorsement ability without VE
// status (Section 4.3). The live check is `ve_status || lnc_status`. Nothing sets
// `lnc_status` yet (Certification Center is deferred), so the LNC branch is
// unreachable in practice today but implemented correctly regardless.
model Endorsement {
  endorsement_id String @id @default(uuid())

  seed_id String
  seed    LearningSeed @relation(fields: [seed_id], references: [seed_id])

  // The endorsing VE. Held ve_status at creation time (checked in application
  // logic); the FK is to the permanent account, not a status snapshot.
  endorser_account_id String
  endorser            Account @relation("EndorserAccount", fields: [endorser_account_id], references: [account_id])

  created_at DateTime @default(now())

  // One live endorsement per VE per seed; the toggle-off is a hard delete of
  // this row, so re-endorsing is a fresh insert with a new created_at.
  @@unique([seed_id, endorser_account_id])
  @@index([seed_id])
  @@index([endorser_account_id])
}

// Community Recommendation (Section 9.2) — GLOBAL to the module as a whole, not
// per-seed. Binary toggle (hard delete on click-again, same as Endorsement).
// The recommender must pass the shared eligibility gate (7-day account age +
// completed profile, Section 9.5) — enforced in lib/endorsement.ts via the
// single shared lib/eligibility.ts function that comments and commission-support
// will reuse.
model CommunityRecommendation {
  recommendation_id String @id @default(uuid())

  module_id String
  module    ContextualizedModule @relation(fields: [module_id], references: [module_id])

  recommender_account_id String
  recommender            Account @relation("RecommenderAccount", fields: [recommender_account_id], references: [account_id])

  // The module version active when this recommendation was made (snapshot of
  // ContextualizedModule.version), mirroring ModuleReport.module_version. Drives
  // the white (current-version) / grey (sum of prior versions) count split
  // (Module Editor Task 2). Recommendations PERSIST across version changes; the
  // split is purely informational and sorting always uses the combined total.
  module_version Int

  created_at DateTime @default(now())

  // One live recommendation per account per module; toggle-off hard-deletes.
  @@unique([module_id, recommender_account_id])
  @@index([module_id])
  @@index([recommender_account_id])
}
