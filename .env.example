# Copy this file to .env and adjust as needed. .env is git-ignored and must
# never be committed. scripts/check.sh sources .env itself and fails fast if
# DATABASE_URL or TEST_DATABASE_URL is missing.

# --- Postgres container credentials (consumed by docker-compose.yml) ---
POSTGRES_USER=ln
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=legiblenovelty

# --- Prisma / application connection strings ---
# Host is the compose service name "postgres" (resolved on the compose network).
# REQUIRED — main application database.
DATABASE_URL=postgresql://ln:change_me_local_dev@postgres:5432/legiblenovelty?schema=public
# Shadow database for `prisma migrate dev` (provisioned by db/init).
SHADOW_DATABASE_URL=postgresql://ln:change_me_local_dev@postgres:5432/legiblenovelty_shadow?schema=public
# REQUIRED — dedicated test database used by scripts/check.sh (migrations + tests).
TEST_DATABASE_URL=postgresql://ln:change_me_local_dev@postgres:5432/legiblenovelty_test?schema=public

# --- Auth.js ---
# Generate with: openssl rand -base64 33
AUTH_SECRET=replace_me_with_a_generated_secret
AUTH_TRUST_HOST=true

# --- Local email catcher (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@legiblenovelty.local
MAILPIT_API_URL=http://mailpit:8025
